{
  "name": "dutch-buddy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "build:web": "npm --prefix web run build",
    "build:backend": "npm --prefix backend run build && node -e \"const fs = require('node:fs'); fs.cpSync('backend/src/data', 'backend/dist/data', { recursive: true, force: true });\"",
    "build": "npm run build:web && npm run build:backend",
    "dev": "npm run build:web && tsx backend/src/main.ts",
    "start": "node backend/dist/main.js",
    "test": "npm --prefix backend test"
  },
  "dependencies": {
    "@google/genai": "^0.3.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "grammy": "^1.30.0",
    "openai": "^6.49.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.5"
  }
}
